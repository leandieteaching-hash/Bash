{
  "name": "studio-os",
  "version": "1.0.0-alpha.1",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@studio-os/web",
    "dev:services": "docker compose up -d postgres mailpit",
    "dev:services:down": "docker compose down",
    "dev:services:logs": "docker compose logs -f postgres mailpit",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:release": "npm run test:release --workspace=@studio-os/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:release",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,yml,yaml,css,scss}": "prettier --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.0"
  }
}
